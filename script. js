async function getWeather(){
  const city = document.getElementById("cityInput").value || "Vijayawada";
  
  try{
    // Step 1 - City name to lat/long
    const geoRes = await fetch(`https://geocoding-api.open-meteo.com/v1/search?name=${city}&count=1`);
    const geoData = await geoRes.json();
    
    if(!geoData.results){
      alert("City not found ma Sravani! Spelling chudu ma");
      return;
    }
    
    const lat = geoData.results[0].latitude;
    const lon = geoData.results[0].longitude;
    const cityName = geoData.results[0].name;

    // Step 2 - Get weather
    const weatherRes = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,relative_humidity_2m,wind_speed_10m,weather_code`);
    const weatherData = await weatherRes.json();
    const current = weatherData.current;

    document.getElementById("cityName").innerText = cityName;
    document.getElementById("temp").innerText = Math.round(current.temperature_2m) + "°C";
    document.getElementById("desc").innerText = "Weather Code: " + current.weather_code + " - Live!";
    document.getElementById("humidity").innerText = current.relative_humidity_2m + "% Humidity";
    document.getElementById("wind").innerText = current.wind_speed_10m + " km/h Wind";

  }catch(e){
    alert("Error ma! Internet chudu ma Sravani");
    console.log(e);
  }
}

document.querySelector("button").addEventListener("click", getWeather);
getWeather();
