const apiKey = "fd2d3a8a6a8e4b1e8e8e9a0c8c8c8c8c"; // demo key

async function getWeather(){
  const city = document.getElementById("cityInput").value || "Vijayawada";
  const url = `https://api.openweathermap.org/data/2.5/weather?q=${city}&appid=${apiKey}&units=metric`;

  try{
    const res = await fetch(url);
    const data = await res.json();

    if(data.cod!== 200){
      // QA Testing - Demo data for Vijayawada
      document.getElementById("cityName").innerText = city;
      document.getElementById("temp").innerText = "31°C";
      document.getElementById("desc").innerText = "Partly Cloudy (Demo)";
      document.getElementById("humidity").innerText = "84%";
      document.getElementById("wind").innerText = "7.8 km/h";
      return;
    }

    document.getElementById("cityName").innerText = data.name;
    document.getElementById("temp").innerText = Math.round(data.main.temp)+"°C";
    document.getElementById("desc").innerText = data.weather[0].description;
    document.getElementById("humidity").innerText = data.main.humidity+"%";
    document.getElementById("wind").innerText = data.wind.speed+" km/h";
  }catch(e){
    alert("API Error - Showing demo data ma Sravani");
  }
}

// Auto load Vijayawada
getWeather();
